# Copy to backend/.env for local development. Never commit the copy.

APP_ENV=development

# Matches docker-compose.yml. Local only.
DATABASE_URL=postgresql://recon:recon_local_only@localhost:5433/recon
# Jobs and migrations need a direct connection. On Neon, this is the URL WITHOUT "-pooler".
# Leave empty to reuse DATABASE_URL.
DATABASE_URL_DIRECT=

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-value
ACCESS_TOKEN_MINUTES=480

# Must be true on any HTTPS deployment
COOKIE_SECURE=false

MAX_UPLOAD_MB=25
MAX_IMPORT_ROWS=200000
# Runs background jobs in the API process. Turn off only for tests.
ENABLE_JOB_WORKER=true
# Optional. Without a key, mapping suggestions are rule-based.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Enables the upload probe used to test hosting limits. Keep false unless testing.
ENABLE_DIAGNOSTICS=false
# Shows the "Synthetic demo data" banner
DEMO_MODE=true

# Used only by scripts/seed_foundation.py. Choose your own values.
SEED_FINANCE_PASSWORD=
SEED_FOUNDER_PASSWORD=
